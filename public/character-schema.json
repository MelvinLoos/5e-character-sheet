{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "character-schema.json",
  "title": "D&D 5e Character (Full Round-Trip)",
  "description": "The complete persisted shape of a character (CharacterData). This schema is the single source of truth for importing a character that was previously exported from this application. Unlike schema.json (the sparse input schema used for AI generation), this schema accepts derived/calculated fields such as abilityScores, profBonus and hp_max so that an exported character can be re-imported losslessly. The application re-derives calculated values after import, so they are optional here.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "The character's name.",
      "errorMessage": "Character name must be a non-empty string."
    },
    "title": {
      "type": "string",
      "description": "An optional title or epithet for the character.",
      "default": ""
    },
    "jobInParty": {
      "type": "string",
      "description": "The character's job or role in the party.",
      "default": ""
    },
    "class": {
      "type": ["string", "null"],
      "description": "The character's class key (e.g. \"Wizard\")."
    },
    "renownTier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "default": 1,
      "description": "Renown Tier (1-3) for the West Marches progression system. Maps to an effective level via TIER_TO_LEVEL."
    },
    "renownMilestones": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Number of renown milestones earned within the current tier."
    },
    "species": {
      "type": ["string", "null"],
      "description": "The character's species key (e.g. \"Elf\")."
    },
    "subChoice": {
      "type": ["string", "null"],
      "default": null,
      "description": "Selected sub-choice id for species with lineages/ancestries/legacies (e.g. \"high-elf\")."
    },
    "featureChoices": {
      "type": "object",
      "description": "Selected feature-choice options keyed by choice id, e.g. { \"fighting-style\": [\"defense\"], \"eldritch-invocations\": [\"agonizing-blast\"] }.",
      "additionalProperties": { "type": "array", "items": { "type": "string" } },
      "default": {}
    },
    "background": {
      "type": ["string", "null"],
      "description": "The character's background key (e.g. \"Sage\")."
    },
    "pointBuyBaseScores": {
      "type": "object",
      "description": "The six base ability scores (8-15) used for point buy.",
      "properties": {
        "str": { "type": "integer", "minimum": 8, "maximum": 15 },
        "dex": { "type": "integer", "minimum": 8, "maximum": 15 },
        "con": { "type": "integer", "minimum": 8, "maximum": 15 },
        "int": { "type": "integer", "minimum": 8, "maximum": 15 },
        "wis": { "type": "integer", "minimum": 8, "maximum": 15 },
        "cha": { "type": "integer", "minimum": 8, "maximum": 15 }
      },
      "required": ["str", "dex", "con", "int", "wis", "cha"],
      "errorMessage": "Point buy base scores must be an object with str, dex, con, int, wis, cha properties."
    },
    "backgroundBonusSelections": {
      "type": "object",
      "description": "The ability scores selected for the background's +2 and +1 bonuses.",
      "properties": {
        "plusTwo": { "type": ["string", "null"], "enum": ["str", "dex", "con", "int", "wis", "cha", null] },
        "plusOne": { "type": ["string", "null"], "enum": ["str", "dex", "con", "int", "wis", "cha", null] }
      },
      "required": ["plusTwo", "plusOne"],
      "errorMessage": "Background bonus selections are required."
    },
    "abilityScores": {
      "type": "object",
      "description": "Final ability scores including background and feature bonuses. Optional on import; recomputed by the mutation pipeline.",
      "properties": {
        "str": { "type": "number" },
        "dex": { "type": "number" },
        "con": { "type": "number" },
        "int": { "type": "number" },
        "wis": { "type": "number" },
        "cha": { "type": "number" }
      }
    },
    "profBonus": {
      "type": "number",
      "description": "Proficiency bonus. Optional on import; recomputed from the effective level."
    },
    "proficiencies": {
      "type": "object",
      "description": "Skill and saving throw proficiencies.",
      "properties": {
        "skills": {
          "type": "array",
          "description": "Skill names (lowercase, no spaces) the character is proficient in.",
          "items": { "type": "string" }
        },
        "savingThrows": {
          "type": "array",
          "description": "Ability score abbreviations (lowercase) for saving throw proficiencies.",
          "items": { "type": "string", "enum": ["str", "dex", "con", "int", "wis", "cha"] }
        }
      },
      "required": ["skills", "savingThrows"]
    },
    "combat": {
      "type": "object",
      "description": "Combat statistics. hp_max and ac may be recomputed on import unless combat.isAcOverride is true.",
      "properties": {
        "ac": { "type": "number" },
        "isAcOverride": { "type": "boolean", "default": false },
        "hp_max": { "type": "number" },
        "hp_current": { "type": "number" },
        "hp_temp": { "type": "number", "default": 0 },
        "speed": { "type": "string", "default": "30ft" }
      },
      "required": ["ac", "speed"]
    },
    "attacks": {
      "type": "array",
      "description": "List of character attacks.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "atkStat": { "type": ["string", "null"], "enum": ["str", "dex", "con", "int", "wis", "cha", null] },
          "customAtkValue": { "type": "number" },
          "dmgDie": {
            "type": "string",
            "pattern": "^\\d+d\\d+$",
            "errorMessage": "Damage die must be in the format 'XdY' (e.g., '1d8')."
          },
          "dmgStat": { "type": ["string", "null"], "enum": ["str", "dex", "con", "int", "wis", "cha", null] },
          "customDmgValue": { "type": "number" },
          "dmgBonus": { "type": "number", "default": 0 },
          "type": { "type": "string", "description": "Damage type (e.g. \"slashing\", \"fire\")." },
          "notes": { "type": "string" },
          "weaponMastery": { "type": "string" }
        },
        "required": ["name", "dmgDie", "type"]
      }
    },
    "features": {
      "type": "array",
      "description": "List of character features and traits.",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "desc": { "type": "string" },
          "key": { "type": "boolean", "default": false },
          "source": { "type": "string" },
          "featureType": { "type": "string" },
          "actionType": { "type": "string" },
          "casterType": { "type": ["string", "null"] },
          "uses": {
            "type": ["object", "null"],
            "description": "Legacy use-tracking shape.",
            "properties": { "total": { "type": "number" }, "per": { "type": "string" } },
            "required": ["total", "per"]
          },
          "resource": {
            "type": ["object", "null"],
            "description": "Resource tracking for limited-use features.",
            "properties": {
              "resourceType": { "type": "string", "enum": ["static", "scaling"] },
              "value": { "type": "integer", "minimum": 0 },
              "scalingStat": { "type": ["string", "null"], "enum": ["pb", "str", "dex", "con", "int", "wis", "cha", null] },
              "reset": { "type": "string" }
            },
            "required": ["resourceType"]
          },
          "used": { "type": "number", "description": "Runtime tracker of how many uses have been consumed." },
          "grantsSpells": { "type": "boolean" },
          "grantedSpellLevels": { "type": "array", "items": { "type": "number" } },
          "abilityModifiers": { "type": "object", "additionalProperties": { "type": "number" } },
          "prerequisite": { "type": "string" },
          "minTier": { "type": "number" }
        },
        "required": ["title", "desc"]
      }
    },
    "equipment": {
      "type": "string",
      "description": "Free-text description of the character's equipment."
    },
    "personality": {
      "type": "object",
      "description": "Personality details.",
      "properties": {
        "traits": { "type": "string" },
        "ideal": { "type": "string" },
        "bond": { "type": "string" },
        "flaw": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["traits", "ideal", "bond", "flaw"]
    },
    "spellcasting": {
      "type": ["object", "null"],
      "description": "Spellcasting details, populated if a feature grants casting.",
      "properties": {
        "ability": { "type": "string", "enum": ["str", "dex", "con", "int", "wis", "cha"] },
        "slotsSpent": { "type": "object", "additionalProperties": { "type": "number" } }
      }
    },
    "spells": {
      "type": "array",
      "description": "List of known/prepared spells.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "level": { "type": "integer", "minimum": 0, "maximum": 9 },
          "desc": { "type": "string" },
          "source": { "type": "string" },
          "school": { "type": "string" },
          "castingTime": { "type": "string" },
          "range": { "type": "string" },
          "components": { "type": "string" },
          "duration": { "type": "string" },
          "concentration": { "type": "boolean" },
          "ritual": { "type": "boolean" },
          "prepared": { "type": "boolean" },
          "classes": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["name", "level", "desc"]
      }
    },
    "gold": { "type": "number", "minimum": 0, "default": 0, "description": "Gold pieces held." },
    "supply": { "type": "number", "minimum": 0, "default": 0, "description": "Supply resource amount." },
    "influence": { "type": "number", "minimum": 0, "default": 0, "description": "Influence resource amount." },
    "inventorySlots": {
      "type": "number",
      "minimum": 0,
      "description": "Number of inventory slots available."
    },
    "equippedGear": {
      "type": "array",
      "description": "List of equipped gear items.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "catalogId": { "type": "string", "description": "Canonical equipment catalog id (e.g. \"scale-mail\")." },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string" },
          "slotCost": { "type": "number" },
          "rarity": { "type": "string" },
          "theme": { "type": "string" }
        },
        "required": ["id", "name", "type"]
      }
    },
    "consumables": {
      "type": "array",
      "description": "List of consumable items tracked with usage dice.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "slotCost": { "type": "number" },
          "usageDie": { "type": "string" }
        },
        "required": ["id", "name", "type", "usageDie"]
      }
    }
  },
  "required": ["name"],
  "errorMessage": {
    "required": {
      "name": "Character name is required."
    }
  }
}
