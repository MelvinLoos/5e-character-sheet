# Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OAuth redirect URL used by Discord authentication flow
# Example: https://your-app.netlify.app/auth/callback
VITE_SUPABASE_REDIRECT_URL=

# PostHog analytics configuration
VITE_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Set to "true" to disable PostHog (e.g. in tests). Leave unset in production.
VITE_POSTHOG_DISABLED=

# MCP server (server-side only; set in Netlify, never prefix with VITE_)
# Supabase service-role key. Bypasses RLS: keep it secret and server-side.
SUPABASE_SERVICE_ROLE_KEY=
# Static Bearer token MCP clients send as `Authorization: Bearer <token>`.
# Generate one with: openssl rand -hex 32
MCP_SECRET_TOKEN=
# Supabase auth user id (UUID) that owns characters created through MCP.
MCP_OWNER_USER_ID=
# Comma-separated Discord guild ids whose homebrew spells/feats MCP may read.
# Leave empty to disable guild content.
MCP_OWNER_GUILD_IDS=
