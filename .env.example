# Example environment configuration.
# Copy this file to `.env` and fill in your own values.
# Variables prefixed with VITE_ are exposed to the client-side app via import.meta.env.

# Supabase project URL (used by the client for online character sharing).
# Online sharing is gracefully disabled when this is not set.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous (public) client key.
# This is a public key, but it should still come from config rather than be committed inline.
# Online sharing is gracefully disabled when this is not set.
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Gemini API key used by the Netlify serverless function for AI character generation.
# This is a server-side secret (NOT exposed to the client) and is read from process.env.
GEMINI_API_KEY=your_gemini_api_key
