# Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OAuth redirect URL used by Discord authentication flow
# Example: https://your-app.netlify.app/auth/callback
VITE_SUPABASE_REDIRECT_URL=

# PostHog analytics configuration
VITE_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Set to "true" to disable PostHog (e.g. in tests). Leave unset in production.
VITE_POSTHOG_DISABLED=
